#!/usr/bin/env fish
# Meadow — fish config (Linux port of the macOS setup)

fish_add_path ~/.local/bin
fish_add_path ~/.cargo/bin
fish_add_path ~/.config/emacs/bin

set -gx EDITOR emacsclient
set -gx VISUAL emacsclient
set -gx PAGER less
set -gx TERMINAL ghostty

alias neofetch='fastfetch -c neofetch'
alias e='emacsclient -c -n'
alias ll='ls -alF'
alias ls='ls --color=auto'
alias grep='grep --color=auto'
alias theme='switch-theme toggle'

if status is-interactive
    if test "$TERM_PROGRAM" != "vscode" -a "$TERMINAL_EMULATOR" != "JetBrains-JediTerm" -a -z "$INSIDE_EMACS"
        if type -q fastfetch
            fastfetch -c neofetch 2>/dev/null
        end
    end
end

set -U fish_greeting

starship init fish | source

# Meadow colors are generated by switch-theme.sh into
# ~/.config/fish/conf.d/90-meadow-theme.fish
