#!/usr/bin/env bash
# Meadow power menu (rofi), with Nerd Font glyphs instead of emojis.
set -euo pipefail

STATE="${XDG_CONFIG_HOME:-$HOME/.config}/meadow/state"
MODE="$(cat "$STATE" 2>/dev/null || echo dark)"
THEME="$HOME/.config/rofi/meadow.rasi"
[ "$MODE" = "light" ] && THEME="$HOME/.config/rofi/meadow-light.rasi"

LOCK=$'\uf023'
LOGOUT=$'\uf2f5'
SUSPEND=$'\uf186'
REBOOT=$'\uf021'
POWER=$'\uf011'

confirm() {
    local answer
    answer="$(printf 'No\nYes' | rofi -dmenu -theme "$THEME" -p "$1" -i)"
    [ "$answer" = "Yes" ]
}

choice="$(
    printf '%s\n' \
        "$LOCK  Lock" \
        "$LOGOUT  Log out" \
        "$SUSPEND  Suspend" \
        "$REBOOT  Reboot" \
        "$POWER  Shutdown" |
        rofi -dmenu -theme "$THEME" -p "power"
)"

case "$choice" in
    *Lock)
        if command -v i3lock >/dev/null 2>&1; then
            i3lock -c 1f1a24
        else
            loginctl lock-session
        fi
        ;;
    *"Log out")
        if ! awesome-client 'awesome.quit()' >/dev/null 2>&1; then
            loginctl terminate-session "${XDG_SESSION_ID:-}"
        fi
        ;;
    *Suspend) systemctl suspend ;;
    *Reboot) confirm "reboot?" && systemctl reboot ;;
    *Shutdown) confirm "shutdown?" && systemctl poweroff ;;
esac
