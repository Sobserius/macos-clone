#!/usr/bin/env bash
# Screenshot helper: `screenshot full` or `screenshot region`.
set -euo pipefail

mode="${1:-full}"
dir="${XDG_PICTURES_DIR:-$HOME/Pictures}/Screenshots"
mkdir -p "$dir"
file="$dir/$(date +%Y%m%d-%H%M%S).png"

if [ "$mode" = "region" ]; then
    maim -s "$file"
else
    maim "$file"
fi

[ -f "$file" ] || exit 0

if command -v xclip >/dev/null 2>&1; then
    xclip -selection clipboard -t image/png -i "$file" >/dev/null 2>&1 || true
fi
if command -v notify-send >/dev/null 2>&1; then
    notify-send "Screenshot saved" "$file"
fi
